{
  "name": "fix-the-speaker",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate:og": "node scripts/generate-og-image.mjs",
    "generate:favicons": "node scripts/generate-favicons.mjs",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "deploy": "npm run generate:sitemap && astro build && wrangler deploy",
    "pages:deploy": "npm run generate:sitemap && astro build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.1.0",
    "astro": "^7.2.10",
    "tailwindcss": "^4.1.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "wrangler": "^4.129.0"
  }
}
