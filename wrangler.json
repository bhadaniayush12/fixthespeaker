{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fix-the-speaker",
  "main": "worker.js",
  "compatibility_date": "2026-09-04",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "fixthespeaker.com", "custom_domain": true },
    { "pattern": "www.fixthespeaker.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "kv_namespaces": [
    {
      "binding": "SUBSCRIBERS",
      "id": "59c637ffe94b47118273e947c6f7ded2"
    }
  ]
}
