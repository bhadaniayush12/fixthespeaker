---
import AboutPage from '../../components/pages/AboutPage.astro';
import { languages, defaultLang, type SupportedLang } from '../../i18n/ui';

export async function getStaticPaths() {
  const nonDefaultLangs = (Object.keys(languages) as SupportedLang[]).filter((l) => l !== defaultLang);
  return nonDefaultLangs.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
---

<AboutPage lang={lang as SupportedLang} />
