---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found | Fix The Speaker"
  description="The page you were looking for does not exist. Return to the free phone speaker cleaner and water eject tool."
  noindex
>
  <main id="main" class="container-site flex flex-1 flex-col items-center justify-center py-24 text-center sm:py-32">
    <p class="font-mono text-xs uppercase tracking-[0.14em] text-primary">Error 404</p>
    <h1 class="mt-4 text-4xl font-semibold leading-[1.05] tracking-[-0.04em] text-ink sm:text-5xl">Page not found</h1>
    <p class="mt-4 max-w-sm text-[15px] leading-6 text-body">
      That link is broken or the page has moved. The speaker cleaner is still right where you left it.
    </p>
    <a href="/" class="btn btn-primary mt-8">Back to home</a>
  </main>
</Layout>
