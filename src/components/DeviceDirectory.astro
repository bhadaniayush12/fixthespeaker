---
import { type SupportedLang, defaultLang, useTranslations } from '../i18n/ui';
import { deviceList } from '../data/devices';
import { getLocalizedDevice } from '../i18n/deviceTranslations';

export interface Props {
  lang?: SupportedLang;
  title?: string;
  subtitle?: string;
}

const {
  lang = defaultLang,
  title,
  subtitle,
} = Astro.props;

const t = useTranslations(lang);
const displayTitle = title || t.searchDirectoryTitle;
const displaySubtitle = subtitle || t.searchDirectorySubtitle;

const brandOrder = ['Apple', 'Samsung', 'Google', 'Xiaomi', 'OnePlus', 'Vivo', 'Oppo', 'Realme', 'Motorola', 'Universal'];
const localizedDevices = deviceList
  .map((device) => getLocalizedDevice(device, lang))
  .sort((a, b) => {
    const brandA = brandOrder.indexOf(a.brand);
    const brandB = brandOrder.indexOf(b.brand);
    const orderA = brandA === -1 ? brandOrder.length : brandA;
    const orderB = brandB === -1 ? brandOrder.length : brandB;

    return orderA === orderB ? a.name.localeCompare(b.name) : orderA - orderB;
  });

const brandOptions = [
  { value: 'apple', label: 'Apple' },
  { value: 'samsung', label: 'Samsung' },
  { value: 'google', label: 'Google Pixel' },
  { value: 'xiaomi', label: 'Xiaomi / Poco' },
  { value: 'oneplus', label: 'OnePlus' },
  { value: 'wearables-audio', label: 'Wearables & Audio' },
  { value: 'others', label: 'Others' },
];

function getDeviceUrl(slug: string): string {
  return lang === defaultLang ? `/${slug}` : `/${lang}/${slug}`;
}

const clientDevicesPayload = localizedDevices.map((device) => ({
  name: device.name,
  shortName: device.shortName,
  brand: device.brand,
  category: device.category,
  ipRating: device.ipRating.split('(')[0].trim(),
  url: getDeviceUrl(device.slug),
}));
---

<section id="device-directory" class="container-site pb-16 sm:pb-24 scroll-mt-20" aria-labelledby="directory-heading">
  <div class="rounded-3xl border border-hairline bg-elevated/70 p-6 sm:p-10 backdrop-blur-md shadow-2xl shadow-black/40">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <p class="font-mono text-xs uppercase tracking-[0.14em] text-primary">{t.searchDirectoryEyebrow}</p>
        <h2 id="directory-heading" class="mt-2 text-2xl font-bold tracking-[-0.02em] text-ink sm:text-3xl">
          {displayTitle}
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-body sm:text-base">
          {displaySubtitle}
        </p>
      </div>
      <span class="hidden shrink-0 items-center gap-2 rounded-full border border-primary/20 bg-primary/10 px-3.5 py-1.5 font-mono text-xs font-medium text-primary md:inline-flex">
        <span class="size-2 animate-pulse rounded-full bg-primary" aria-hidden="true"></span>
        {localizedDevices.length} Device Profiles
      </span>
    </div>

    <div class="mt-8 rounded-2xl border border-hairline bg-canvas/80 p-4 shadow-inner">
      <div class="grid grid-cols-1 items-end gap-3 sm:grid-cols-2 lg:grid-cols-12">
        <div class="lg:col-span-3">
          <label for="brandSelect" class="mb-1.5 block font-mono text-xs font-semibold uppercase tracking-wider text-ink">
            Brand
          </label>
          <div class="relative">
            <select
              id="brandSelect"
              class="min-h-[44px] w-full cursor-pointer appearance-none rounded-xl border border-hairline bg-elevated px-3.5 py-2 pr-10 text-sm font-medium text-ink transition-all focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
            >
              <option value="">Select a brand</option>
              {brandOptions.map((brand) => (
                <option value={brand.value}>{brand.label}</option>
              ))}
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3.5 text-mute" aria-hidden="true">
              <svg viewBox="0 0 20 20" class="size-4" fill="currentColor">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"></path>
              </svg>
            </div>
          </div>
        </div>

        <div class="lg:col-span-4">
          <label for="modelSelect" class="mb-1.5 block font-mono text-xs font-semibold uppercase tracking-wider text-ink">
            Model
          </label>
          <div class="relative">
            <select
              id="modelSelect"
              disabled
              data-placeholder="Select a model"
              class="min-h-[44px] w-full cursor-pointer appearance-none rounded-xl border border-hairline bg-elevated px-3.5 py-2 pr-10 text-sm font-medium text-ink transition-all focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 disabled:cursor-not-allowed disabled:opacity-50"
            >
              <option value="">Select a model</option>
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3.5 text-mute" aria-hidden="true">
              <svg viewBox="0 0 20 20" class="size-4" fill="currentColor">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"></path>
              </svg>
            </div>
          </div>
        </div>

        <div class="lg:col-span-2">
          <button
            id="cleanDeviceButton"
            type="button"
            disabled
            class="flex min-h-[44px] w-full cursor-pointer touch-manipulation items-center justify-center gap-2 rounded-xl bg-primary px-4 text-sm font-semibold text-on-primary shadow-lg shadow-primary/20 transition-all duration-200 hover:bg-primary-bright active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-50 disabled:shadow-none"
          >
            <span>Clean Device</span>
            <svg viewBox="0 0 16 16" class="size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4"></path>
            </svg>
          </button>
        </div>

        <div class="sm:col-span-2 lg:col-span-3">
          <label for="device-search-input" class="mb-1.5 block font-mono text-xs font-semibold uppercase tracking-wider text-ink">
            Instant search
          </label>
          <div class="relative">
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-mute" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.3-4.3"></path>
              </svg>
            </div>
            <input
              id="device-search-input"
              type="search"
              placeholder={t.searchDirectoryPlaceholder}
              data-no-results={t.noDevicesFound}
              autocomplete="off"
              class="min-h-[44px] w-full rounded-xl border border-hairline bg-elevated/90 py-2 pl-10 pr-9 text-xs text-ink placeholder:text-mute transition-all focus:border-primary focus:bg-elevated focus:outline-none focus:ring-2 focus:ring-primary/20 sm:text-sm"
            />
            <button
              id="device-search-clear"
              type="button"
              aria-label="Clear search"
              class="absolute inset-y-0 right-0 hidden cursor-pointer items-center pr-3 text-mute transition-colors hover:text-ink"
            >
              <svg viewBox="0 0 20 20" class="size-4" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
              </svg>
            </button>

            <div
              id="device-search-results"
              class="absolute left-0 right-0 top-full z-30 mt-2 hidden max-h-72 space-y-1 overflow-y-auto rounded-2xl border border-hairline bg-canvas/95 p-2 shadow-2xl backdrop-blur-xl"
              aria-live="polite"
            ></div>
          </div>
        </div>
      </div>
    </div>

    <details class="mt-4 border border-slate-800 rounded-lg p-3 bg-[#0b0f19]">
      <summary class="cursor-pointer text-sm font-medium text-cyan-400 hover:text-cyan-300">
        Browse all 158 device guides ▾
      </summary>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2 pt-3 text-xs text-slate-400">
        {localizedDevices.map((device) => (
          <a href={getDeviceUrl(device.slug)} class="rounded px-1 py-1 hover:text-cyan-300">
            {device.name}
          </a>
        ))}
      </div>
    </details>

    <script id="devices-catalog-data" type="application/json" set:html={JSON.stringify(clientDevicesPayload)} />
  </div>
</section>

<script>
  type ClientDevice = {
    name: string;
    shortName: string;
    brand: string;
    category: string;
    ipRating: string;
    url: string;
  };

  function initDeviceDirectorySelector() {
    const directory = document.getElementById('device-directory');
    if (!directory || directory.dataset.selectorInitialized === 'true') return;

    const brandSelect = directory.querySelector<HTMLSelectElement>('#brandSelect');
    const modelSelect = directory.querySelector<HTMLSelectElement>('#modelSelect');
    const cleanButton = directory.querySelector<HTMLButtonElement>('#cleanDeviceButton');
    const searchInput = directory.querySelector<HTMLInputElement>('#device-search-input');
    const searchClear = directory.querySelector<HTMLButtonElement>('#device-search-clear');
    const searchResults = directory.querySelector<HTMLDivElement>('#device-search-results');
    const dataScript = directory.querySelector<HTMLScriptElement>('#devices-catalog-data');

    if (!brandSelect || !modelSelect || !cleanButton || !dataScript) return;
    directory.dataset.selectorInitialized = 'true';

    let devices: ClientDevice[] = [];
    try {
      devices = JSON.parse(dataScript.textContent || '[]');
    } catch {
      devices = [];
    }

    const standardBrands = ['Apple', 'Samsung', 'Google', 'Xiaomi', 'OnePlus'];

    function getDevicesForBrand(brandId: string): ClientDevice[] {
      switch (brandId) {
        case 'apple':
          return devices.filter((device) => device.brand === 'Apple');
        case 'samsung':
          return devices.filter((device) => device.brand === 'Samsung');
        case 'google':
          return devices.filter((device) => device.brand === 'Google');
        case 'xiaomi':
          return devices.filter((device) => device.brand === 'Xiaomi');
        case 'oneplus':
          return devices.filter((device) => device.brand === 'OnePlus');
        case 'wearables-audio':
          return devices.filter((device) => device.category === 'earbuds' || device.category === 'smartwatch');
        case 'others':
          return devices.filter((device) => !standardBrands.includes(device.brand));
        default:
          return [];
      }
    }

    function updateModelOptions(brandId: string) {
      const placeholder = document.createElement('option');
      placeholder.value = '';
      placeholder.textContent = modelSelect.dataset.placeholder || 'Select a model';
      modelSelect.replaceChildren(placeholder);

      const matchingDevices = getDevicesForBrand(brandId);
      matchingDevices.forEach((device) => {
        const option = document.createElement('option');
        option.value = device.url;
        option.textContent = device.name;
        modelSelect.appendChild(option);
      });

      modelSelect.disabled = matchingDevices.length === 0;
      cleanButton.disabled = true;
    }

    brandSelect.addEventListener('change', () => {
      updateModelOptions(brandSelect.value);
    });

    modelSelect.addEventListener('change', () => {
      cleanButton.disabled = !modelSelect.value;
    });

    cleanButton.addEventListener('click', () => {
      if (modelSelect.value) window.location.assign(modelSelect.value);
    });

    if (!searchInput || !searchClear || !searchResults) return;

    function hideSearchResults() {
      searchResults.classList.add('hidden');
      searchResults.replaceChildren();
    }

    function renderSearchSuggestions(query: string) {
      const normalizedQuery = query.toLowerCase().trim();
      searchResults.replaceChildren();

      if (!normalizedQuery) {
        searchResults.classList.add('hidden');
        return;
      }

      const matches = devices
        .filter((device) => {
          const searchableText = `${device.name} ${device.shortName} ${device.brand} ${device.category} ${device.ipRating}`.toLowerCase();
          return searchableText.includes(normalizedQuery);
        })
        .slice(0, 8);

      if (!matches.length) {
        const emptyState = document.createElement('div');
        emptyState.className = 'px-4 py-3 text-center text-xs text-mute';
        emptyState.textContent = `${searchInput.dataset.noResults || 'No matching devices found'} ("${query}")`;
        searchResults.appendChild(emptyState);
      } else {
        matches.forEach((device) => {
          const link = document.createElement('a');
          link.href = device.url;
          link.className = 'group flex items-center justify-between gap-3 rounded-xl px-3 py-2 text-xs text-body transition-colors hover:bg-primary/10 hover:text-primary';

          const deviceName = document.createElement('span');
          deviceName.className = 'truncate font-medium text-ink group-hover:text-primary';
          deviceName.textContent = device.name;

          const deviceMeta = document.createElement('span');
          deviceMeta.className = 'shrink-0 font-mono text-[10px] text-mute';
          deviceMeta.textContent = device.brand;

          link.append(deviceName, deviceMeta);
          searchResults.appendChild(link);
        });
      }

      searchResults.classList.remove('hidden');
    }

    searchInput.addEventListener('input', () => {
      searchClear.classList.toggle('hidden', !searchInput.value);
      searchClear.classList.toggle('flex', Boolean(searchInput.value));
      renderSearchSuggestions(searchInput.value);
    });

    searchInput.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        const firstResult = searchResults.querySelector<HTMLAnchorElement>('a');
        if (firstResult) {
          event.preventDefault();
          window.location.assign(firstResult.href);
        }
      } else if (event.key === 'Escape') {
        hideSearchResults();
      }
    });

    searchClear.addEventListener('click', () => {
      searchInput.value = '';
      searchClear.classList.add('hidden');
      searchClear.classList.remove('flex');
      hideSearchResults();
      searchInput.focus();
    });

    document.addEventListener('pointerdown', (event) => {
      if (!directory.contains(event.target as Node)) hideSearchResults();
    });
  }

  initDeviceDirectorySelector();
  document.addEventListener('astro:page-load', initDeviceDirectorySelector);
</script>
