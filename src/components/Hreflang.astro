---
import { languages, defaultLang } from '../i18n/ui';
import { isTranslatedSubpageIndexed } from '../data/indexing';
import { isIndexableDevicePath, indexableDeviceLocales } from '../data/indexable-devices';

export interface Props {
  currentPath?: string;
  siteUrl?: string;
  localized?: boolean;
}

const SITE_URL = Astro.props.siteUrl || 'https://fixthespeaker.com';
const pathname = Astro.props.currentPath || Astro.url.pathname;

// 1. Normalize path: strip trailing slashes and file extensions
const cleanPath = pathname.replace(/\/index(\.html)?$/, '').replace(/\.html$/, '').replace(/\/+$/, '') || '/';

// 2. Extract locale segment and subpage slug
const segments = cleanPath.split('/').filter(Boolean);
const isLocalized = segments.length > 0 && segments[0] in languages && segments[0] !== defaultLang;
const subpageSegments = isLocalized ? segments.slice(1) : segments;
const subpageSlug = subpageSegments.length > 0 ? `/${subpageSegments.join('/')}` : '';

// 3. Construct hreflang array with x-default and all configured locales
const defaultUrl = `${SITE_URL}${subpageSlug || '/'}`;

// Only advertise translations that are indexable (see src/data/indexing.ts).
const localized = (Astro.props.localized ?? true) && isTranslatedSubpageIndexed(subpageSlug);
const localeUrl = (l: string) => (l === defaultLang ? defaultUrl : `${SITE_URL}/${l}${subpageSlug}`);

// Allowlisted device pages only link the locales that are themselves indexable (see src/data/indexable-devices.ts).
const deviceLocales = isIndexableDevicePath(cleanPath) ? indexableDeviceLocales(subpageSlug.slice(1)) : [];
const hreflangEntries = deviceLocales.length
  ? [
      ...(deviceLocales.includes(defaultLang) ? [{ lang: 'x-default', href: defaultUrl }] : []),
      ...deviceLocales.map((l) => ({ lang: l, href: localeUrl(l) })),
    ]
  : [
      { lang: 'x-default', href: defaultUrl },
      { lang: 'en', href: defaultUrl },
      ...(!localized ? [] : Object.keys(languages))
        .filter((l) => l !== defaultLang)
        .map((l) => ({ lang: l, href: localeUrl(l) })),
    ];
---

{hreflangEntries.map(({ lang, href }) => (
  <link rel="alternate" hreflang={lang} href={href} />
))}
