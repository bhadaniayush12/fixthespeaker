---
import { languages, defaultLang } from '../i18n/ui';

export interface Props {
  currentPath?: string;
  siteUrl?: string;
}

const SITE_URL = Astro.props.siteUrl || 'https://fixthespeaker.com';
const pathname = Astro.props.currentPath || Astro.url.pathname;

// 1. Normalize path: strip trailing slashes and file extensions
const cleanPath = pathname.replace(/\/index(\.html)?$/, '').replace(/\.html$/, '').replace(/\/+$/, '') || '/';

// 2. Extract locale segment and subpage slug
const segments = cleanPath.split('/').filter(Boolean);
const isLocalized = segments.length > 0 && segments[0] in languages && segments[0] !== defaultLang;
const subpageSegments = isLocalized ? segments.slice(1) : segments;
const subpageSlug = subpageSegments.length > 0 ? `/${subpageSegments.join('/')}` : '';

// 3. Construct hreflang array with x-default and all configured locales
const defaultUrl = `${SITE_URL}${subpageSlug || '/'}`;

const hreflangEntries = [
  { lang: 'x-default', href: defaultUrl },
  { lang: 'en', href: defaultUrl },
  ...Object.keys(languages)
    .filter((l) => l !== defaultLang)
    .map((l) => ({
      lang: l,
      href: `${SITE_URL}/${l}${subpageSlug}`,
    })),
];
---

{hreflangEntries.map(({ lang, href }) => (
  <link rel="alternate" hreflang={lang} href={href} />
))}
