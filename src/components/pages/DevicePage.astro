---
import Layout from '../../layouts/Layout.astro';
import SpeakerTool from '../SpeakerTool.astro';
import { type SupportedLang, defaultLang, useTranslations } from '../../i18n/ui';
import { type DeviceData, devices } from '../../data/devices';
import { getLocalizedDevice } from '../../i18n/deviceTranslations';
import { isPublishedDevice } from '../../data/indexable-devices';
import { getDeviceSpecifics, deviceSpecificLabels } from '../../data/deviceSpecifics';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { guides } from '../../data/guides';

export interface Props {
  device: DeviceData;
  lang?: SupportedLang;
}

// Only published devices (brand hubs + allowlisted models) are built, so every device page is indexable.
const { device, lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const localizedDevice = getLocalizedDevice(device, lang);

const SITE_URL = 'https://fixthespeaker.com';
const pageUrl = lang === defaultLang 
  ? `${SITE_URL}/${localizedDevice.slug}` 
  : `${SITE_URL}/${lang}/${localizedDevice.slug}`;

const homeUrl = getRelativeLocaleUrl(lang);
const isHub = device.category === 'hub';

// Brand hub that each model page sits under (also the 301 target for retired model URLs of that brand).
const hubSlugFor = (d: DeviceData): string =>
  d.category === 'earbuds'
    ? 'clean-airpods-speaker'
    : d.brand === 'Apple'
    ? 'fix-iphone-speaker'
    : d.brand === 'Samsung'
    ? 'eject-water-samsung-galaxy'
    : 'fix-android-speaker';
const parentHub = isHub ? undefined : devices[hubSlugFor(device)];

// Sourced, model-specific section (only on the pages listed in src/data/deviceSpecifics.ts).
const specifics = getDeviceSpecifics(device.slug, lang);
const specificLabels = deviceSpecificLabels[lang] ?? deviceSpecificLabels.en!;
// Model pages show only the sourced steps and FAQ; hubs keep their own hand-written steps, tips and FAQs.
const steps = specifics ? specifics.steps.map((text, i) => ({ name: `Step ${i + 1}`, text })) : localizedDevice.steps;
const faqs = specifics ? [specifics.faq] : localizedDevice.faqs;
// Only show a water rating that comes from an official source (src/data/deviceSpecifics.ts).
const sourcedIpRating = specifics?.ipRating.match(/\bIP[0-9X]{2}\b/)?.[0];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    // --- Organization reference (defined on homepage, referenced here) ---
    {
      '@type': 'Organization',
      '@id': `${SITE_URL}/#organization`,
      name: 'Fix The Speaker',
      url: `${SITE_URL}/`,
    },
    // --- WebSite ---
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: 'Fix The Speaker',
      description: 'Free browser tool that plays a low-frequency tone through your speaker to help clear water and dust.',
      inLanguage: lang,
      publisher: { '@id': `${SITE_URL}/#organization` },
    },
    // --- BreadcrumbList: enables breadcrumb rich results in SERPs ---
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Fix The Speaker',
          item: `${SITE_URL}/`,
        },
        ...(parentHub
          ? [{ '@type': 'ListItem', position: 2, name: parentHub.shortName, item: `${SITE_URL}/${parentHub.slug}` }]
          : []),
        {
          '@type': 'ListItem',
          position: parentHub ? 3 : 2,
          name: localizedDevice.shortName,
          item: pageUrl,
        },
      ],
    },
    // --- WebApplication ---
    {
      '@type': 'WebApplication',
      '@id': `${pageUrl}#app`,
      name: `${localizedDevice.name} Water Eject & Speaker Cleaner`,
      url: pageUrl,
      description: localizedDevice.metaDescription,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: localizedDevice.name,
      browserRequirements: 'Requires a modern web browser with HTML5 Web Audio API support',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      featureList: ['Low-frequency water eject tone', 'Dust cleaner sweep', 'Left and right speaker test'],
    },
    // --- HowTo ---
    {
      '@type': 'HowTo',
      '@id': `${pageUrl}#howto`,
      name: `${t.howToCleanPrefix} ${localizedDevice.shortName}`,
      description: localizedDevice.metaDescription,
      step: steps.map((step, i) => ({
        '@type': 'HowToStep',
        position: i + 1,
        name: step.name,
        text: step.text,
        url: `${pageUrl}#step-${i + 1}`,
      })),
    },
    // --- FAQPage ---
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: faqs.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
};

// Related pages: a hub lists its models and the other hubs; a model lists its hub and the other models under it.
const publishedDevices = Object.values(devices).filter(isPublishedDevice);
const relatedDevices = (
  isHub
    ? [
        ...publishedDevices.filter((d) => d.category !== 'hub' && hubSlugFor(d) === device.slug),
        ...publishedDevices.filter((d) => d.category === 'hub' && d.slug !== device.slug),
      ]
    : [parentHub!, ...publishedDevices.filter((d) => d.category !== 'hub' && d.slug !== device.slug && d.brand === device.brand)]
).map((dev) => getLocalizedDevice(dev, lang));

const RELATED_GUIDE_SLUGS: Record<string, string[]> = {
  'fix-iphone-speaker': ['iphone-speaker-muffled-after-water', 'phone-fell-in-water-first-10-minutes'],
  'eject-water-samsung-galaxy': ['samsung-moisture-detected-warning', 'phone-fell-in-water-first-10-minutes'],
  'fix-android-speaker': ['muffled-phone-speaker-water-dust-or-damage', 'phone-fell-in-water-first-10-minutes'],
  'clean-airpods-speaker': ['airpods-water-damage-what-to-do', 'how-to-clean-airpods-speaker-mesh'],
  'fix-apple-watch-speaker': ['apple-watch-water-lock-explained', 'does-water-eject-sound-really-work'],
};
// Hubs link their guides; model pages link the water eject guide from the tone note instead.
const deviceRelatedGuides = (isHub ? RELATED_GUIDE_SLUGS[device.slug] ?? [] : [])
  .map((slug) => guides.find((g) => g.slug === slug))
  .filter(Boolean);
---

<Layout
  title={localizedDevice.metaTitle}
  description={localizedDevice.metaDescription}
  lang={lang}
  jsonLd={jsonLd}
>
  <main id="main" class="flex-1" data-device-slug={device.slug}>
    
    <!-- Hero Section -->
    <section class="relative overflow-hidden" aria-labelledby="hero-heading">
      <div class="bg-mesh pointer-events-none absolute inset-x-0 top-0 h-[32rem]" aria-hidden="true"></div>
      <div class="bg-grid pointer-events-none absolute inset-x-0 top-0 h-[32rem]" aria-hidden="true"></div>

      <div class="container-site relative pt-10 pb-4 text-center sm:pt-16 sm:pb-6">
        
        <!-- Breadcrumb / Back Link -->
        <nav aria-label="Breadcrumb" class="mb-4 inline-flex items-center gap-2 text-xs text-mute font-mono">
          <a href={homeUrl} class="transition-colors hover:text-ink">{t.navHome}</a>
          <span>/</span>
          {parentHub && (
            <>
              <a href={`/${parentHub.slug}`} class="transition-colors hover:text-ink">{parentHub.shortName}</a>
              <span>/</span>
            </>
          )}
          <span class="text-primary">{localizedDevice.shortName}</span>
        </nav>

        <p class="animate-rise font-mono text-[11px] uppercase tracking-[0.14em] text-primary sm:text-xs">
          {localizedDevice.badge}
        </p>

        <h1
          id="hero-heading"
          class="text-shine animate-rise mx-auto mt-3 max-w-3xl text-3xl font-semibold leading-[1.12] tracking-[-0.035em] [animation-delay:80ms] sm:text-5xl md:text-6xl sm:leading-[1.02]"
        >
          {localizedDevice.heroHeading}
        </h1>

        <p class="animate-rise mx-auto mt-3 max-w-xl text-[15px] leading-relaxed text-body [animation-delay:160ms] sm:text-lg sm:leading-7 sm:mt-4">
          {localizedDevice.heroSubtitle}
        </p>

        <!-- Hardware Tags -->
        <div class="animate-rise mx-auto mt-5 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 font-mono text-[11px] uppercase tracking-[0.12em] text-mute [animation-delay:240ms] sm:mt-6 sm:gap-x-4">
          {sourcedIpRating && (
            <>
              <span class="inline-flex items-center gap-1.5 text-body">
                <svg viewBox="0 0 16 16" class="size-3.5 text-primary" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="8" r="6"/><path d="m5.5 8 2 2 3.5-3.5"/></svg>
                {sourcedIpRating}
              </span>
              <span class="text-faint">·</span>
            </>
          )}
          <span class="text-primary/90">{t.noAppRequired}</span>
        </div>
      </div>
    </section>

    <!-- Interactive Tool Component -->
    {/* Hubs label the tool with their own steps (except Apple Watch, whose steps describe Water Lock on the watch); model pages keep the tool's default steps. */}
    <SpeakerTool lang={lang} customSteps={isHub && device.slug !== 'fix-apple-watch-speaker' ? localizedDevice.steps : undefined} device={device.slug} />

    <!-- Device-Specific Notes (sourced from the manufacturer) -->
    {specifics && (
      <section class="container-site pb-14 sm:pb-20" aria-labelledby="device-specific-heading" data-device-specific>
        <div class="mx-auto max-w-3xl rounded-3xl border border-hairline bg-elevated/40 p-6 sm:p-8">
          <p class="font-mono text-xs uppercase tracking-[0.14em] text-primary">{specificLabels.eyebrow}</p>
          <h2 id="device-specific-heading" class="mt-2 text-2xl font-bold tracking-[-0.02em] text-ink sm:text-3xl">
            {localizedDevice.shortName}
          </h2>

          <h3 class="mt-6 text-base font-semibold text-ink">{specificLabels.speakers}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-body">{specifics.speakers}</p>

          <h3 class="mt-5 text-base font-semibold text-ink">{specificLabels.ipRating}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-body">{specifics.ipRating}</p>

          <h3 class="mt-5 text-base font-semibold text-ink">{specificLabels.steps}</h3>
          <ol class="mt-2 list-decimal space-y-2 pl-5 text-sm leading-relaxed text-body">
            {specifics.steps.map((step, i) => <li id={`step-${i + 1}`}>{step}</li>)}
          </ol>

          <p class="mt-6 border-t border-hairline pt-4 text-xs text-mute">
            {specificLabels.sources}:{' '}
            {specifics.sources.map((source, i) => (
              <>
                {i > 0 && ' · '}
                <a href={source.url} target="_blank" rel="noopener" class="underline decoration-hairline underline-offset-2 hover:text-ink">{source.label}</a>
              </>
            ))}
          </p>
        </div>
      </section>
    )}

    <!-- What the tone does (the same tone plays on every page) -->
    {specifics && (
      <section class="container-site pb-14 sm:pb-20" aria-labelledby="tone-heading">
        <div class="mx-auto max-w-3xl">
          <h2 id="tone-heading" class="text-base font-semibold text-ink">About the tone</h2>
          <p class="mt-1.5 text-sm leading-relaxed text-body">
            Water Eject plays one low-frequency tone, the same on every page; nothing is tuned to the {localizedDevice.shortName}.
            It can shake loose droplets in the grille but cannot dry the inside or repair a damaged speaker.
            <a href="/guides/does-water-eject-sound-really-work" class="underline decoration-hairline underline-offset-2 hover:text-ink">How water eject sounds work</a>.
          </p>
        </div>
      </section>
    )}

    {!specifics && (<>
    <!-- Step-by-Step How-To Guide -->
    <section class="container-site pb-14 sm:pb-20" aria-labelledby="howto-heading">
      <div class="mx-auto max-w-3xl">
        <p class="font-mono text-xs uppercase tracking-[0.14em] text-primary">{t.cleaningProtocolEyebrow}</p>
        <h2 id="howto-heading" class="mt-2 text-2xl font-bold tracking-[-0.02em] text-ink sm:text-3xl">
          {t.howToCleanPrefix} {localizedDevice.shortName}
        </h2>
        
        <div class="mt-8 space-y-4">
          {localizedDevice.steps.map((step, idx) => (
            <div id={`step-${idx + 1}`} class="group rounded-2xl border border-hairline bg-elevated/60 p-5 sm:p-6 transition-colors hover:border-primary/40">
              <div class="flex items-start gap-4">
                <span class="flex size-8 shrink-0 items-center justify-center rounded-xl bg-primary/10 font-mono text-xs font-bold text-primary">
                  0{idx + 1}
                </span>
                <div>
                  <h3 class="text-base font-semibold text-ink">{step.name}</h3>
                  <p class="mt-1.5 text-sm leading-relaxed text-body">{step.text}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Technical Tips & Warnings -->
    <section class="container-site pb-14 sm:pb-20" aria-labelledby="tips-heading">
      <div class="mx-auto max-w-3xl rounded-3xl border border-hairline bg-elevated/40 p-6 sm:p-8">
        <div class="flex items-center gap-2.5 text-amber-400">
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" />
            <line x1="12" y1="9" x2="12" y2="13" />
            <line x1="12" y1="17" x2="12.01" y2="17" />
          </svg>
          <h2 id="tips-heading" class="text-base font-semibold text-ink">{t.safetyTipsHeading}</h2>
        </div>
        <ul class="mt-4 space-y-3">
          {localizedDevice.technicalTips.map((tip) => (
            <li class="flex items-start gap-3 text-sm leading-relaxed text-body">
              <span class="text-primary mt-0.5">•</span>
              <span>{tip}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
    </>)}

    <!-- Device-Specific FAQ Section -->
    <section class="container-site pb-16 sm:pb-20" aria-labelledby="device-faq-heading">
      <div class="mx-auto max-w-3xl">
        <p class="font-mono text-xs uppercase tracking-[0.14em] text-primary">{t.faqEyebrow}</p>
        <h2 id="device-faq-heading" class="mt-2 text-2xl font-bold tracking-[-0.02em] text-ink sm:text-3xl">
          {localizedDevice.shortName} {t.deviceFaqHeadingSuffix}
        </h2>
        
        <div class="mt-6 sm:mt-8 divide-y divide-hairline rounded-2xl border border-hairline bg-elevated/70">
          {faqs.map(({ q, a }) => (
            <details class="group px-5 sm:px-6">
              <summary class="flex min-h-[48px] cursor-pointer list-none items-center justify-between gap-4 py-4 sm:py-5 text-left text-[15px] font-medium text-ink touch-manipulation [&::-webkit-details-marker]:hidden">
                <span>{q}</span>
                <svg viewBox="0 0 16 16" class="size-4 shrink-0 text-mute transition-transform duration-200 group-open:rotate-45" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true" focusable="false">
                  <path d="M8 2.5v11M2.5 8h11" />
                </svg>
              </summary>
              <p class="pb-4 sm:pb-5 text-[15px] leading-relaxed text-body">{a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Related Troubleshooting & Care Guides -->
    {deviceRelatedGuides.length > 0 && (
      <section class="container-site border-t border-hairline py-14 sm:py-20" aria-labelledby="related-guides-heading">
        <div class="mx-auto max-w-4xl text-left">
          <p class="font-mono text-xs uppercase tracking-[0.14em] text-primary">Troubleshooting &amp; Care</p>
          <div class="mt-2 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-2">
            <h2 id="related-guides-heading" class="text-2xl font-bold tracking-[-0.02em] text-ink sm:text-3xl">
              Related Guides
            </h2>
            <a href="/guides" class="text-xs font-medium text-primary hover:underline">
              View all guides →
            </a>
          </div>

          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            {deviceRelatedGuides.map((g) => (
              <a
                href={`/guides/${g.slug}`}
                class="group rounded-2xl border border-hairline bg-elevated/60 p-5 transition-all duration-200 hover:-translate-y-1 hover:border-primary/50 hover:bg-elevated cursor-pointer touch-manipulation"
              >
                <h3 class="text-base font-semibold text-ink group-hover:text-primary transition-colors">
                  {g.title}
                </h3>
                <p class="mt-2 text-xs leading-relaxed text-body line-clamp-2">
                  {g.description}
                </p>
                <span class="mt-3 inline-flex items-center gap-1 text-xs font-medium text-primary">
                  Read guide
                  <svg viewBox="0 0 16 16" class="size-3 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M3 8h10M9 4l4 4-4 4" />
                  </svg>
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Related device pages -->
    <section class="container-site border-t border-hairline py-14 sm:py-20" aria-labelledby="crosslinks-heading">
      <div class="mx-auto max-w-4xl text-center">
        <p class="font-mono text-xs uppercase tracking-[0.14em] text-primary">{t.otherDevicesEyebrow}</p>
        <h2 id="crosslinks-heading" class="mt-2 text-2xl font-bold tracking-[-0.02em] text-ink sm:text-3xl">
          {t.otherDevicesHeading}
        </h2>
        {isHub && (
          <p class="mt-2 text-sm text-mute">
            {t.otherDevicesSubtitle}
          </p>
        )}

        <div class="mt-8 flex flex-wrap justify-center gap-2.5">
          {relatedDevices.map((rel) => (
            <a
              href={`/${rel.slug}`}
              data-hub-link={rel.slug}
              class="inline-flex min-h-[44px] items-center gap-2 rounded-xl border border-hairline bg-elevated/60 px-4 py-2 text-sm font-medium text-ink transition-colors hover:border-primary/50 hover:text-primary touch-manipulation"
            >
              {rel.shortName}
              <svg viewBox="0 0 16 16" class="size-3 text-mute" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 12l4-4-4-4"/></svg>
            </a>
          ))}
        </div>

        <a href={`${homeUrl}#device-directory`} class="btn btn-ghost mt-8 min-h-[44px] px-5 text-sm">
          {t.searchDirectoryTitle} →
        </a>
      </div>
    </section>

  </main>

  <script>
    function trackDeviceEvent(eventName: string, params: Record<string, any> = {}) {
      if (typeof (window as any).trackEvent === 'function') {
        (window as any).trackEvent(eventName, params);
        return;
      }
      const consent = (window as any).fixSpeakerConsent?.read();
      if (consent?.analytics === false) return;
      if (typeof (window as any).gtag === 'function') {
        (window as any).gtag('event', eventName, params);
      }
    }

    function initScrollTracking() {
      const main = document.querySelector('main[data-device-slug]');
      if (!main) return;
      const fromDevice = main.getAttribute('data-device-slug') || '';

      // Standard GA4 scroll depth thresholds:
      // 50% = scrolled past tool into hardware specs, how-to, and safety tips
      // 90% = reached device FAQ and bottom related content (matches GA4 enhanced measurement)
      const thresholds = [50, 90];
      const triggered = new Set<number>();
      let ticking = false;

      function checkScroll() {
        const docEl = document.documentElement;
        const body = document.body;
        const scrollHeight = Math.max(docEl.scrollHeight, body.scrollHeight);
        const innerHeight = window.innerHeight || docEl.clientHeight;
        const scrollY = window.scrollY || docEl.scrollTop || body.scrollTop || 0;

        if (scrollHeight <= 0 || innerHeight <= 0) {
          ticking = false;
          return;
        }

        // Standard GTM / GA4 scroll depth formula: (current scroll position + viewport height) / total height
        const percentScrolled = Math.min(100, Math.round(((scrollY + innerHeight) / scrollHeight) * 100));

        for (const threshold of thresholds) {
          if (percentScrolled >= threshold && !triggered.has(threshold)) {
            triggered.add(threshold);
            trackDeviceEvent('scroll', {
              percent_scrolled: threshold,
              device: fromDevice,
            });
          }
        }

        ticking = false;
      }

      function onScroll() {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(checkScroll);
        }
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      checkScroll();
    }

    function initHubNavigationTracking() {
      const main = document.querySelector('main[data-device-slug]');
      if (!main) return;
      const fromDevice = main.getAttribute('data-device-slug') || '';

      // Track cross-links in the "Other Devices" related section
      document.querySelectorAll<HTMLAnchorElement>('[data-hub-link]').forEach((link) => {
        link.addEventListener('click', () => {
          const toDevice = link.dataset.hubLink || '';
          trackDeviceEvent('hub_navigation', {
            from_device: fromDevice,
            to_device: toDevice,
            link_type: 'cross_link',
            transport_type: 'beacon',
          });
        });
      });

      // Track directory cross-links on device page
      const directory = document.getElementById('device-directory');
      if (directory) {
        directory.addEventListener('click', (e) => {
          const anchor = (e.target as HTMLElement).closest('a');
          if (!anchor) return;
          const href = anchor.getAttribute('href');
          if (!href || href.startsWith('#') || (href.startsWith('http') && !href.includes(window.location.host))) return;

          const segments = href.split('?')[0].split('#')[0].split('/').filter(Boolean);
          const targetSlug = segments.pop();
          const nonDeviceSlugs = ['privacy', 'terms', 'about', 'contact', 'es', 'ja', 'fr', 'de', 'pt', 'ko', 'it'];
          if (targetSlug && targetSlug !== fromDevice && !nonDeviceSlugs.includes(targetSlug)) {
            trackDeviceEvent('hub_navigation', {
              from_device: fromDevice,
              to_device: targetSlug,
              link_type: 'directory_link',
              transport_type: 'beacon',
            });
          }
        });
      }
    }

    initHubNavigationTracking();
    initScrollTracking();
    document.addEventListener('astro:page-load', () => {
      initHubNavigationTracking();
      initScrollTracking();
    });
  </script>
</Layout>

