---
import ContentLayout from '../../layouts/ContentLayout.astro';
import { defaultLang, type SupportedLang } from '../../i18n/ui';
import { subpagesContent } from '../../i18n/subpages';

export interface Props {
  lang?: SupportedLang;
}

const { lang = defaultLang } = Astro.props;
const content = subpagesContent[lang]?.privacy || subpagesContent[defaultLang].privacy;
const formatItemHtml = (text: string) => {
  return text.replace(
    /(https?:\/\/[^\s\)\x27\",\uFF08\uFF09]+)/g,
    '<a href="$1" target="_blank" rel="noopener noreferrer" class="text-primary underline underline-offset-2 hover:text-primary-bright">$1</a>'
  );
};
---

<ContentLayout
  title={content.title}
  description={content.description}
  heading={content.heading}
  eyebrow={content.eyebrow}
  updated={content.updated}
  lang={lang}
>
  <p>{content.intro}</p>

  {content.sections.map((section) => (
    <>
      {section.title && <h2>{section.title}</h2>}
      {section.paragraphs.map((p) => (
        <p>{p}</p>
      ))}
      {section.list && (
        <ul>
          {section.list.map((item) => (
            <li set:html={formatItemHtml(item)} />
          ))}
        </ul>
      )}
    </>
  ))}
</ContentLayout>
