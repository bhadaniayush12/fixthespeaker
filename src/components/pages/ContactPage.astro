---
import ContentLayout from '../../layouts/ContentLayout.astro';
import { defaultLang, type SupportedLang, useTranslations } from '../../i18n/ui';

export interface Props {
  lang?: SupportedLang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const navPrefix = lang === defaultLang ? '' : `/${lang}`;
const EMAIL = 'hello@fixthespeaker.com';
---

<ContentLayout
  title="Contact | Fix The Speaker"
  description="Contact Fix The Speaker with questions, bug reports or feedback about the free phone speaker cleaner. We usually reply within a few business days."
  heading="Contact"
  eyebrow={t.navContact}
  lang={lang}
>
  <p>
    Found a bug, have a question or want to suggest an improvement to the speaker cleaner? Send us an email and we will
    get back to you, usually within a few business days.
  </p>

  <p>
    <a
      href={`mailto:${EMAIL}?subject=Fix%20The%20Speaker`}
      class="btn btn-primary no-underline font-bold text-[#041019] hover:text-[#041019] focus-visible:text-[#041019] cursor-pointer touch-manipulation min-h-[44px]"
    >
      <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m3 7 9 6 9-6" />
      </svg>
      <span>Email {EMAIL}</span>
    </a>
  </p>

  <h2>Helpful details to include</h2>
  <ul>
    <li>Your device model and operating system version.</li>
    <li>The browser you used, for example Safari or Chrome.</li>
    <li>Which mode you ran (Water Eject, Dust Cleaner or Speaker Test) and what happened.</li>
    <li>Whether the speaker was recently exposed to liquid or debris.</li>
  </ul>

  <h2>Before you write</h2>
  <p>
    We cannot diagnose or repair hardware by email. If your speaker still sounds muffled after several cleaning cycles,
    the <a href={`${navPrefix}/#tool`}>Speaker Test</a> shows a silent channel, or your phone shows a liquid-detection warning, please
    contact your device manufacturer or a repair service.
  </p>
  <p>
    For information about data and cookies, see the <a href={`${navPrefix}/privacy`}>privacy policy</a>. For the conditions of using
    the tool, see the <a href={`${navPrefix}/terms`}>terms of use</a>.
  </p>
</ContentLayout>
