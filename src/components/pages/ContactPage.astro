---
import ContentLayout from '../../layouts/ContentLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { defaultLang, type SupportedLang, useTranslations } from '../../i18n/ui';
import { subpagesContent } from '../../i18n/subpages';

export interface Props {
  lang?: SupportedLang;
}

const { lang = defaultLang } = Astro.props;
const content = subpagesContent[lang]?.contact || subpagesContent[defaultLang].contact;
const EMAIL = 'support@fixthespeaker.com';
---

<ContentLayout
  title={content.title}
  description={content.description}
  heading={content.heading}
  eyebrow={content.eyebrow}
  lang={lang}
>
  <p>{content.intro}</p>

  <p>
    <a
      href={`mailto:${EMAIL}?subject=Fix%20The%20Speaker`}
      class="btn btn-primary no-underline font-bold text-[#041019] hover:text-[#041019] focus-visible:text-[#041019] cursor-pointer touch-manipulation min-h-[44px]"
    >
      <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m3 7 9 6 9-6" />
      </svg>
      <span>{content.buttonText}</span>
    </a>
  </p>

  <h2>{content.detailsTitle}</h2>
  <ul>
    {content.detailsList.map((item) => (
      <li>{item}</li>
    ))}
  </ul>

  <h2>{content.beforeTitle}</h2>
  <p>{content.beforeText}</p>
  <p>
    <a href={getRelativeLocaleUrl(lang, 'privacy')}>{useTranslations(lang).navPrivacy}</a> &bull; <a href={getRelativeLocaleUrl(lang, 'terms')}>{useTranslations(lang).navTerms}</a>
  </p>
</ContentLayout>
