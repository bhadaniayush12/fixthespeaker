---
import ContentLayout from '../../layouts/ContentLayout.astro';
import { defaultLang, type SupportedLang } from '../../i18n/ui';
import { subpagesContent } from '../../i18n/subpages';

export interface Props {
  lang?: SupportedLang;
}

const { lang = defaultLang } = Astro.props;
const content = subpagesContent[lang]?.about || subpagesContent[defaultLang].about;
const navPrefix = lang === defaultLang ? '' : `/${lang}`;
---

<ContentLayout
  title={content.title}
  description={content.description}
  heading={content.heading}
  eyebrow={content.eyebrow}
  lang={lang}
>
  <p>{content.intro}</p>

  {content.sections.map((section) => (
    <>
      {section.title && <h2>{section.title}</h2>}
      {section.paragraphs.map((p) => (
        <p>{p}</p>
      ))}
      {section.list && (
        <ul>
          {section.list.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )}
    </>
  ))}

  <h2>{lang === 'es' ? 'Contacto' : lang === 'ja' ? 'お問い合わせ' : lang === 'fr' ? 'Contact' : lang === 'de' ? 'Kontakt' : lang === 'pt' ? 'Contato' : lang === 'ko' ? '문의하기' : lang === 'it' ? 'Contatti' : 'Get in touch'}</h2>
  <p>
    <a href={`${navPrefix}/contact`}>{lang === 'es' ? 'Página de contacto' : lang === 'ja' ? 'お問い合わせページ' : lang === 'fr' ? 'Page de contact' : lang === 'de' ? 'Kontaktseite' : lang === 'pt' ? 'Página de contato' : lang === 'ko' ? '문의 페이지' : lang === 'it' ? 'Pagina contatti' : 'Contact page'}</a> &bull; <a href={`${navPrefix}/privacy`}>{lang === 'es' ? 'Política de Privacidad' : lang === 'ja' ? 'プライバシーポリシー' : lang === 'fr' ? 'Confidentialité' : lang === 'de' ? 'Datenschutz' : lang === 'pt' ? 'Privacidade' : lang === 'ko' ? '개인정보처리방침' : lang === 'it' ? 'Privacy' : 'Privacy Policy'}</a> &bull; <a href={`${navPrefix}/terms`}>{lang === 'es' ? 'Términos' : lang === 'ja' ? '利用規約' : lang === 'fr' ? 'Conditions' : lang === 'de' ? 'Bedingungen' : lang === 'pt' ? 'Termos' : lang === 'ko' ? '이용약관' : lang === 'it' ? 'Termini' : 'Terms'}</a>
  </p>
</ContentLayout>
