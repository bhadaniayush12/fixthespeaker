---
import ContentLayout from '../../layouts/ContentLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { defaultLang, type SupportedLang, useTranslations } from '../../i18n/ui';
import { subpagesContent } from '../../i18n/subpages';

export interface Props {
  lang?: SupportedLang;
}

const { lang = defaultLang } = Astro.props;
const content = subpagesContent[lang]?.about || subpagesContent[defaultLang].about;
---

<ContentLayout
  title={content.title}
  description={content.description}
  heading={content.heading}
  eyebrow={content.eyebrow}
  lang={lang}
>
  <p>{content.intro}</p>

  {content.sections.map((section) => (
    <>
      {section.title && <h2>{section.title}</h2>}
      {section.paragraphs.map((p) => (
        <p>{p}</p>
      ))}
      {section.list && (
        <ul>
          {section.list.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )}
    </>
  ))}

  <h2>{useTranslations(lang).navContact}</h2>
  <p>
    <a href={getRelativeLocaleUrl(lang, 'contact')}>{useTranslations(lang).navContact}</a> &bull; <a href={getRelativeLocaleUrl(lang, 'privacy')}>{useTranslations(lang).navPrivacy}</a> &bull; <a href={getRelativeLocaleUrl(lang, 'terms')}>{useTranslations(lang).navTerms}</a>
  </p>
</ContentLayout>
