---
import Layout from './Layout.astro';
import { defaultLang, type SupportedLang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  heading: string;
  eyebrow?: string;
  updated?: string; // ISO date, e.g. 2026-09-03
  lang?: SupportedLang;
}

const { title, description, heading, eyebrow, updated, lang = defaultLang } = Astro.props;
const lastUpdatedLabels: Record<SupportedLang, string> = {
  en: 'Last updated',
  es: 'Última actualización',
  ja: '最終更新',
  fr: 'Dernière mise à jour',
  de: 'Zuletzt aktualisiert',
  pt: 'Última atualização',
  ko: '최종 업데이트',
  it: 'Ultimo aggiornamento',
};
const updatedLabel = updated
  ? new Date(updated).toLocaleDateString(lang === 'en' ? 'en-US' : lang, { year: 'numeric', month: 'long', day: 'numeric' })
  : null;
---

<Layout title={title} description={description} lang={lang} ogType="article">
  <main id="main" class="container-site flex-1 py-14 sm:py-20">
    <article class="mx-auto max-w-2xl">
      <header class="border-b border-hairline pb-8">
        {eyebrow && <p class="font-mono text-xs uppercase tracking-[0.14em] text-primary">{eyebrow}</p>}
        <h1 class="mt-3 text-4xl font-semibold leading-[1.05] tracking-[-0.04em] text-ink sm:text-5xl">{heading}</h1>
        {updatedLabel && (
          <p class="mt-4 text-sm text-mute">
            {lastUpdatedLabels[lang]} <time datetime={updated}>{updatedLabel}</time>
          </p>
        )}
      </header>
      <div class="rich-text mt-10">
        <slot />
      </div>
    </article>
  </main>
</Layout>
