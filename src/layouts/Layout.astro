---
import { languages, type SupportedLang, defaultLang, useTranslations } from '../i18n/ui';

export interface Props {
  title: string;
  description: string;
  lang?: SupportedLang;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
}

const SITE_NAME = 'Fix The Speaker';
const SITE_URL = 'https://fixthespeaker.com';

const {
  title,
  description,
  lang = defaultLang,
  noindex = false,
  ogType = 'website',
  jsonLd,
} = Astro.props;

const t = useTranslations(lang);
const langMeta = languages[lang] || languages[defaultLang];

const navPrefix = lang === defaultLang ? '' : `/${lang}`;
const NAV = [
  { href: `${navPrefix}/about`, label: t.navAbout },
  { href: `${navPrefix}/privacy`, label: t.navPrivacy },
  { href: `${navPrefix}/terms`, label: t.navTerms },
  { href: `${navPrefix}/contact`, label: t.navContact },
];

const base = Astro.site ?? new URL(SITE_URL);
const cleanPath = Astro.url.pathname.replace(/\/index(\.html)?$/, '').replace(/\.html$/, '') || '/';
const canonical = new URL(cleanPath, base).href;
const ogImage = new URL('/og-image.png', base).href;
const currentPath = cleanPath;
const year = new Date().getFullYear();

const pathSegments = cleanPath.split('/').filter(Boolean);
const hasLangPrefix = pathSegments.length > 0 && pathSegments[0] in languages && pathSegments[0] !== defaultLang;
const subpageSegments = hasLangPrefix ? pathSegments.slice(1) : pathSegments;
const subpageSlug = subpageSegments.length > 0 ? `/${subpageSegments.join('/')}` : '';

const logo = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M11 5 6 9H3v6h3l5 4V5z" fill="currentColor" stroke="none"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/><path d="M18.5 5.5a9 9 0 0 1 0 13"/></svg>`;

// Dynamic Hreflang alternates for current page
const hreflangs: { lang: string; href: string }[] = [
  { lang: 'x-default', href: `${SITE_URL}${subpageSlug || '/'}` },
  { lang: 'en', href: `${SITE_URL}${subpageSlug || '/'}` },
  ...Object.keys(languages)
    .filter((l) => l !== defaultLang)
    .map((l) => ({
      lang: l,
      href: `${SITE_URL}/${l}${subpageSlug}`,
    })),
];
---

<!doctype html>
<html lang={lang} class="h-full">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-5BKNT4C2');</script>
    <!-- End Google Tag Manager -->

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0B0F19" />
    <meta name="color-scheme" content="light dark" />

    {/* Runs before first paint: sets the theme class on <html> so there is no flash. */}
    <script is:inline>
      (function () {
        var el = document.documentElement;
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) { /* storage blocked */ }
        var dark = stored
          ? stored === 'dark'
          : (!window.matchMedia || window.matchMedia('(prefers-color-scheme: dark)').matches);
        el.classList.toggle('dark', dark);
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', dark ? '#0B0F19' : '#FFFFFF');
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />

    {/* Multilingual Hreflang Alternates for Global SEO */}
    {hreflangs.map((h) => (
      <link rel="alternate" hreflang={h.lang} href={h.href} />
    ))}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Fix The Speaker: free water eject & speaker cleaner tool" />
    <meta property="og:locale" content={langMeta.ogLocale} />
    {Object.entries(languages)
      .filter(([k]) => k !== lang)
      .map(([, v]) => (
        <meta property="og:locale:alternate" content={v.ogLocale} />
      ))}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap" />

    {jsonLd && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
    )}
  </head>

  <body class="flex min-h-full flex-col bg-canvas text-body">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5BKNT4C2"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <a href="#main" class="btn btn-primary sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50">
      Skip to content
    </a>

    <!-- Header with 44x44px Apple HIG touch targets & high z-index for iOS -->
    <header class="sticky top-0 z-50 border-b border-hairline bg-canvas/90 backdrop-blur-md transition-shadow shadow-[0_1px_0_rgb(255_255_255/0.04)]">
      <div class="container-site flex items-center justify-between gap-x-4 py-2.5 sm:py-3.5">
        <a
          href={lang === defaultLang ? '/' : `/${lang}`}
          class="flex min-h-[44px] items-center gap-2.5 rounded-pill text-ink cursor-pointer touch-manipulation"
          aria-label="Fix The Speaker, home"
        >
          <span class="grid size-8 place-items-center rounded-lg bg-primary text-on-primary [&>svg]:size-[18px]" set:html={logo} />
          <span class="text-[15px] font-semibold tracking-[-0.02em]">{SITE_NAME}</span>
        </a>

        <div class="flex items-center gap-2 sm:gap-3">
          <nav aria-label="Primary" class="hidden md:flex items-center gap-1 text-sm">
            {NAV.map(({ href, label }) => (
              <a
                href={href}
                aria-current={currentPath === href ? 'page' : undefined}
                class="min-h-[44px] flex items-center rounded-pill px-3.5 py-2 text-body transition-colors hover:text-ink aria-[current=page]:bg-elevated aria-[current=page]:text-ink"
              >
                {label}
              </a>
            ))}
          </nav>

          {/* Language Selector Dropdown: 44x44px touch target, tap-enabled on iOS */}
          <div class="relative group/lang" id="lang-menu-container">
            <button
              type="button"
              id="lang-menu-btn"
              aria-expanded="false"
              aria-haspopup="true"
              aria-label={t.selectLanguage}
              class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center gap-1.5 rounded-full border border-hairline bg-elevated px-3 py-2 text-xs font-medium text-ink transition-colors hover:border-faint focus:outline-none focus:ring-2 focus:ring-primary/40 cursor-pointer touch-manipulation active:scale-95"
            >
              <span class="text-sm">{langMeta.flag}</span>
              <span class="hidden sm:inline font-medium">{langMeta.name}</span>
              <svg viewBox="0 0 16 16" class="size-3 text-mute transition-transform group-hover/lang:rotate-180" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg>
            </button>

            <div
              id="lang-menu-dropdown"
              class="invisible group-hover/lang:visible group-focus-within/lang:visible opacity-0 group-hover/lang:opacity-100 group-focus-within/lang:opacity-100 transition-all duration-150 absolute right-0 top-full mt-2 w-44 rounded-2xl border border-hairline bg-elevated/95 p-1.5 shadow-2xl backdrop-blur-md z-50"
            >
              {Object.entries(languages).map(([k, v]) => (
                <a
                  href={k === defaultLang ? (subpageSlug || '/') : `/${k}${subpageSlug}`}
                  class={`flex min-h-[44px] items-center justify-between rounded-xl px-3 py-2.5 text-xs transition-colors hover:bg-canvas hover:text-ink touch-manipulation cursor-pointer ${
                    k === lang ? 'bg-primary/10 font-semibold text-primary' : 'text-body'
                  }`}
                >
                  <span class="flex items-center gap-2">
                    <span class="text-sm">{v.flag}</span>
                    <span>{v.name}</span>
                  </span>
                  {k === lang && (
                    <svg viewBox="0 0 16 16" class="size-3.5 text-primary" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3.5 8.5 3 3 6-7"/></svg>
                  )}
                </a>
              ))}
            </div>
          </div>

          {/* Theme Toggle: 44x44px Apple HIG Touch Target */}
          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle color theme"
            title="Toggle theme"
            class="grid size-11 min-h-[44px] min-w-[44px] place-items-center rounded-full border border-hairline bg-elevated text-body transition-colors hover:border-faint hover:text-ink active:scale-95 cursor-pointer touch-manipulation focus:outline-none focus:ring-2 focus:ring-primary/40 [&>svg]:size-5"
          >
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
            </svg>
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
          </button>

          <a
            href={`${lang === defaultLang ? '' : `/${lang}`}#tool`}
            class="btn btn-primary min-h-[44px] px-4 text-xs font-medium hidden sm:inline-flex items-center cursor-pointer touch-manipulation"
          >
            {t.navStart}
          </a>
        </div>
      </div>
    </header>

    <slot />

    <footer class="mt-auto relative bg-canvas border-t border-hairline">
      <div class="absolute inset-x-0 top-0 h-px bg-[linear-gradient(90deg,transparent,rgb(6_182_212/0.45),transparent)]" aria-hidden="true"></div>
      <div class="container-site py-12">
        <div class="flex flex-col gap-10 sm:flex-row sm:items-start sm:justify-between">
          <div class="max-w-sm">
            <a href={lang === defaultLang ? '/' : `/${lang}`} class="inline-flex min-h-[44px] items-center gap-2.5 text-ink cursor-pointer" aria-label="Fix The Speaker, home">
              <span class="grid size-8 place-items-center rounded-lg bg-primary text-on-primary [&>svg]:size-[18px]" set:html={logo} />
              <span class="text-[15px] font-semibold tracking-[-0.02em]">{SITE_NAME}</span>
            </a>
            <p class="mt-3 text-sm leading-6 text-mute">
              {t.footerDesc}
            </p>
          </div>
          
          <div class="grid grid-cols-2 gap-8 sm:gap-12">
            <nav aria-label="Footer Pages">
              <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-faint">{t.footerPages}</p>
              <ul class="mt-3 space-y-2 text-sm">
                <li><a href={lang === defaultLang ? '/' : `/${lang}`} class="inline-block py-1 text-body transition-colors hover:text-ink">Home</a></li>
                {NAV.map(({ href, label }) => (
                  <li><a href={href} class="inline-block py-1 text-body transition-colors hover:text-ink">{label}</a></li>
                ))}
              </ul>
            </nav>

            <div>
              <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-faint">{t.selectLanguage}</p>
              <ul class="mt-3 grid grid-cols-1 gap-2 text-xs">
                {Object.entries(languages).map(([k, v]) => (
                  <li>
                    <a
                      href={k === defaultLang ? (subpageSlug || '/') : `/${k}${subpageSlug}`}
                      class={`inline-flex min-h-[36px] items-center gap-1.5 py-1 transition-colors ${
                        k === lang ? 'font-semibold text-primary' : 'text-body hover:text-ink'
                      }`}
                    >
                      <span class="text-sm">{v.flag}</span>
                      <span>{v.name}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        <div class="mt-10 flex flex-col gap-3 border-t border-hairline pt-6 text-xs leading-5 text-faint sm:flex-row sm:items-start sm:justify-between">
          <p>&copy; {year} {SITE_NAME}. {t.footerCopyright}</p>
          <p class="sm:max-w-md sm:text-right">
            {t.disclaimer} {t.footerDisclaimer}
          </p>
        </div>
      </div>
    </footer>

    {/* iOS Touch Event Handling & Theme Toggle Script */}
    <script>
      // iOS / Mobile click toggle for language dropdown menu
      const langContainer = document.getElementById('lang-menu-container');
      const langBtn = document.getElementById('lang-menu-btn');
      const langDropdown = document.getElementById('lang-menu-dropdown');

      if (langBtn && langDropdown) {
        langBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = langDropdown.classList.contains('menu-open');
          if (isOpen) {
            langDropdown.classList.remove('menu-open');
            langBtn.setAttribute('aria-expanded', 'false');
          } else {
            langDropdown.classList.add('menu-open');
            langBtn.setAttribute('aria-expanded', 'true');
          }
        });

        document.addEventListener('click', (e) => {
          if (!langContainer || !langContainer.contains(e.target as Node)) {
            langDropdown.classList.remove('menu-open');
            langBtn.setAttribute('aria-expanded', 'false');
          }
        });
      }

      // Theme toggle
      const root = document.documentElement;
      const meta = document.querySelector('meta[name="theme-color"]');
      const toggle = document.getElementById('theme-toggle');

      const apply = (dark: boolean) => {
        root.classList.toggle('dark', dark);
        if (meta) meta.setAttribute('content', dark ? '#0B0F19' : '#FFFFFF');
      };

      toggle?.addEventListener('click', () => {
        const dark = !root.classList.contains('dark');
        apply(dark);
        try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (e) { /* storage blocked */ }
      });

      // Follow OS preference if user has not chosen
      const mq = window.matchMedia('(prefers-color-scheme: dark)');
      mq.addEventListener?.('change', (e) => {
        let stored = null;
        try { stored = localStorage.getItem('theme'); } catch (_) { /* storage blocked */ }
        if (!stored) apply(e.matches);
      });
    </script>
  </body>
</html>

<style is:global>
  @import 'tailwindcss';

  @theme {
    --font-sans: 'Geist', 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif;
    --font-mono: 'Geist Mono', ui-monospace, SFMono-Regular, monospace;

    --color-canvas: #0b0f19;
    --color-elevated: #111624;
    --color-hairline: #1e2536;
    --color-ink: #f4f6fb;
    --color-body: #a4adc0;
    --color-mute: #6f7889;
    --color-faint: #4b5366;
    --color-primary: #06b6d4;
    --color-primary-bright: #22d3ee;
    --color-on-primary: #041019;

    --radius-pill: 100px;

    --shadow-glow:
      0 0 0 1px rgb(6 182 212 / 0.4), 0 0 48px rgb(6 182 212 / 0.28), 0 0 140px rgb(6 182 212 / 0.14);

    --animate-breathe: breathe 3.2s ease-in-out infinite;
    --animate-ripple: ripple 2.4s cubic-bezier(0.2, 0.6, 0.2, 1) infinite;
    --animate-rise: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    --animate-spin-slow: spin 5s linear infinite;
    --animate-drip: drip 1.5s ease-in infinite;

    @keyframes breathe {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.06); }
    }
    @keyframes ripple {
      0% { transform: scale(1); opacity: 0.55; }
      100% { transform: scale(1.7); opacity: 0; }
    }
    @keyframes rise {
      from { opacity: 0; transform: translateY(14px); }
      to   { opacity: 1; transform: none; }
    }
    @keyframes drip {
      0%   { transform: translateY(0) scale(1); opacity: 0; }
      15%  { opacity: 0.9; }
      100% { transform: translateY(72px) scale(0.5); opacity: 0; }
    }
  }

  :root {
    color-scheme: dark;
    --grid-line: rgb(255 255 255 / 0.035);
    --mesh-1: rgb(6 182 212 / 0.20);
    --mesh-2: rgb(59 130 246 / 0.10);
    --mesh-3: rgb(34 211 238 / 0.08);
    --shine-from: #ffffff;
    --shine-to: #c9d1df;
  }

  html:not(.dark) {
    color-scheme: light;

    --color-canvas: #ffffff;
    --color-elevated: #f4f6fb;
    --color-hairline: #e3e8f1;
    --color-ink: #0f172a;
    --color-body: #475569;
    --color-mute: #64748b;
    --color-faint: #94a3b8;
    --color-primary: #0891b2;
    --color-primary-bright: #06b6d4;
    --color-on-primary: #ffffff;

    --grid-line: rgb(15 23 42 / 0.06);
    --mesh-1: rgb(6 182 212 / 0.16);
    --mesh-2: rgb(59 130 246 / 0.08);
    --mesh-3: rgb(14 165 233 / 0.07);
    --shine-from: #0f172a;
    --shine-to: #47536b;
  }

  /* Sun / moon icon swap */
  .icon-sun { display: none; }
  .dark .icon-moon { display: none; }
  .dark .icon-sun { display: block; }

  /* Mobile / iOS Open State for Language Menu */
  #lang-menu-dropdown.menu-open {
    visibility: visible !important;
    opacity: 1 !important;
    pointer-events: auto !important;
  }

  @utility bg-mesh {
    background:
      radial-gradient(60% 55% at 50% 0%, var(--mesh-1), transparent 70%),
      radial-gradient(40% 40% at 18% 12%, var(--mesh-2), transparent 70%),
      radial-gradient(40% 40% at 82% 16%, var(--mesh-3), transparent 70%);
  }

  @utility bg-grid {
    background-image:
      linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, #000 25%, transparent 100%);
  }

  @utility text-shine {
    background: linear-gradient(180deg, var(--shine-from) 0%, var(--shine-to) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  @layer base {
    html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
    body {
      background-color: var(--color-canvas);
      color: var(--color-body);
      font-family: var(--font-sans);
      -webkit-font-smoothing: antialiased;
      transition: background-color 0.3s ease, color 0.3s ease;
    }
    ::selection { background: rgb(6 182 212 / 0.3); color: var(--color-ink); }
    :focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; }
  }

  @utility container-site {
    width: 100%;
    max-width: 64rem;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  @layer components {
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      min-height: 2.75rem;
      padding: 0 1.25rem;
      border-radius: var(--radius-pill);
      font-size: 0.9375rem;
      font-weight: 500;
      line-height: 1.25rem;
      transition: background-color 150ms, color 150ms, border-color 150ms, transform 150ms;
    }
    .btn:active { transform: scale(0.98); }
    .btn-primary { background: var(--color-primary); color: var(--color-on-primary); }
    .btn-primary:hover { background: var(--color-primary-bright); }
    .btn-ghost { background: var(--color-elevated); color: var(--color-ink); border: 1px solid var(--color-hairline); }
    .btn-ghost:hover { border-color: var(--color-faint); }

    .rich-text { color: var(--color-body); font-size: 1.0625rem; line-height: 1.75; }
    .rich-text > * + * { margin-top: 1.25em; }
    .rich-text h2 {
      margin-top: 2.25em;
      color: var(--color-ink);
      font-size: 1.5rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      line-height: 1.25;
    }
    .rich-text h2:first-child { margin-top: 0; }
    .rich-text h3 { margin-top: 1.75em; color: var(--color-ink); font-size: 1.125rem; font-weight: 600; }
    .rich-text p + p { margin-top: 1em; }
    .rich-text a { color: var(--color-primary); text-decoration: underline; text-underline-offset: 3px; }
    .rich-text a:hover { color: var(--color-primary-bright); }
    .rich-text strong { color: var(--color-ink); font-weight: 600; }
    .rich-text ul, .rich-text ol { padding-left: 1.375rem; }
    .rich-text ul { list-style: disc; }
    .rich-text ol { list-style: decimal; }
    .rich-text li + li { margin-top: 0.5em; }
    .rich-text li::marker { color: var(--color-mute); }
  }
</style>
